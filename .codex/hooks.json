{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(?:mcp__.*(?:playwright|chrome|browser|cua_repl).*|(?:playwright|chrome|browser|cua_repl).*|web__run|mcp__web__.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-tool-budget.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = (git rev-parse --show-toplevel).Trim(); & node (Join-Path $root '.agents/hooks/guard-tool-budget.mjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/cleanup-agent-branches.ts\" --hook",
            "commandWindows": "powershell -NoProfile -Command \"$root = (git rev-parse --show-toplevel).Trim(); & bun (Join-Path $root 'scripts/cleanup-agent-branches.ts') --hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
