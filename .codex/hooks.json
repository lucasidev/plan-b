{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(?:mcp__.*(?:playwright|chrome|browser|cua_repl).*|(?:playwright|chrome|browser|cua_repl).*|web__run|mcp__web__.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-tool-budget.mjs\"",
            "commandWindows": "& node (Join-Path (git rev-parse --show-toplevel).Trim() '.agents/hooks/guard-tool-budget.mjs')",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/cleanup-agent-branches.ts\" --hook",
            "commandWindows": "& bun (Join-Path (git rev-parse --show-toplevel).Trim() 'scripts/cleanup-agent-branches.ts') --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
