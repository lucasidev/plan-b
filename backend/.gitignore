# .NET 10 SDK-style projects

# Build outputs
bin/
obj/
publish/

# Código que genera Wolverine con `dotnet run -- codegen write`. Es output de build, no fuente: lo
# produce el Dockerfile antes de publicar porque en Production el host arranca con
# GeneratedCodeMode=Static y no arranca si falta (ver docs/operations/deploy.md).
host/Planb.Api/Internal/Generated/

# User / IDE artifacts
*.user
*.suo
*.userprefs
*.rsuser

# Ionide (F# VS Code tools) — kept for parity with the MS .NET gitignore template
.ionide/

# NuGet
*.nupkg
*.snupkg
packages/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
coverage.*.xml
