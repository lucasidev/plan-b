# Cross-cutting ignores. Service-specific patterns live in backend/.gitignore
# and frontend/.gitignore.

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vs/
.vscode/
.idea/
.cursor/
.windsurf/
*.swp
*.swo

# Adaptadores de agentes: el contrato compartido es AGENTS.md y los skills viven
# en .agents/skills (estándar Agent Skills), la única fuente. De cada cliente
# entra solo su configuración declarativa (agents = subagentes; rules = reglas
# path-scoped; workflows = orquestaciones multi-agente; hooks y settings); su
# estado local, no. .claude/skills es la copia que lee Claude Code, generada por
# `just sync-agent-config` (la corre el hook SessionStart), así que no entra. La
# higiene de IA (em-dash, atribución) es user-level, no del repo.
.claude/*
!.claude/agents/
!.claude/rules/
!.claude/workflows/
!.claude/hooks/
!.claude/settings.json
!.claude/skills.overrides.json
.codex/*
!.codex/agents/
!.codex/config.toml
!.codex/hooks.json

# Playwright MCP scratch (snapshots, console logs from interactive debugging)
.playwright-mcp/

# Env files (secrets)
.env
.env.local
.env.*.local
!.env.example

# Docker local overrides
docker-compose.override.yml

# Dokploy state
.dokploy/

# Mutation testing (Stryker.NET): reportes e informes de corrida, no entran al repo
**/StrykerOutput/

# k6 (issue #464): si una corrida se exporta con --summary-export, el resultado es local,
# no un artefacto del repo. La medición real se anota en docs/engineering/deploy.md.
k6/summary.json

# Logs / misc
*.log
*.bak
*.tmp
