# Cross-cutting ignores. Service-specific patterns live in backend/.gitignore
# and frontend/.gitignore.

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vs/
.vscode/
.idea/
.cursor/
.windsurf/
*.swp
*.swo

# Adaptadores de agentes: AGENTS.md contiene el contrato compartido. Codex mantiene
# sus skills nativos en .agents/skills y Claude Code mantiene los suyos en
# .claude/skills. Los dos catálogos se versionan y validan por separado: ninguno se
# genera a partir del otro. El estado local de cada cliente no entra al repo.
.claude/*
!.claude/agents/
!.claude/rules/
!.claude/workflows/
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
.codex/*
!.codex/agents/
!.codex/config.toml
!.codex/hooks.json

# Playwright MCP scratch (snapshots, console logs from interactive debugging)
.playwright-mcp/

# Env files (secrets)
.env
.env.local
.env.*.local
!.env.example

# Docker local overrides
docker-compose.override.yml

# Dokploy state
.dokploy/

# Mutation testing (Stryker.NET): reportes e informes de corrida, no entran al repo
**/StrykerOutput/

# k6 (issue #464): si una corrida se exporta con --summary-export, el resultado es local,
# no un artefacto del repo. La medición real se anota en docs/engineering/deploy.md.
k6/summary.json

# Logs / misc
*.log
*.bak
*.tmp
