# planb: .env.stage.local example (DOCUMENTATION ONLY)
#
# Los secretos del stage no viven en el .env de dev: scripts/run-walk.ts lee este archivo
# aparte si existe (gitignorado, patrón .env.*.local). Copiá este ejemplo a .env.stage.local y
# completá el valor real.

STAGE_MAILPIT_UI_AUTH=<usuario:password de la UI de Mailpit del stage, el MAILPIT_UI_AUTH del environment stage en Dokploy>
